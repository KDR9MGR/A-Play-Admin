{
  "buildCommand": "cd apps/A-Play-Admin-main && npm install && npm run build",
  "outputDirectory": "apps/A-Play-Admin-main/dist",
  "installCommand": "echo 'skip root install, handled in buildCommand'",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
